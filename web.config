<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sakthi Auto Component Limited – IIS web.config
  Security hardening – equivalent of .htaccess for IIS/ASP.NET hosting
  Compatible with ASP.NET WebForms (preserves WebResource.axd, ScriptResource.axd)
-->
<configuration>
  <system.web>
    <!-- Disable verbose error pages in production -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/index.html" />
    <!-- Enforce session cookie security -->
    <httpCookies httpOnlyCookies="true" requireSSL="false" sameSite="Lax" />
    <!-- ViewState MAC validation (prevent tampering) -->
    <pages validateRequest="true" enableViewStateMac="true" viewStateEncryptionMode="Auto" />
    <compilation debug="false" />
  </system.web>

  <system.webServer>
    <!-- Disable directory browsing -->
    <directoryBrowse enabled="false" />

    <!-- Remove IIS version header -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="geolocation=(), microphone=(), camera=(), payment=()" />
        <!--
          Content-Security-Policy-Report-Only
          Start in report-only mode; switch to Content-Security-Policy once validated
        -->
        <add name="Content-Security-Policy-Report-Only"
             value="default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com https://www.gstatic.com https://translate.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com https://code.jquery.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://stackpath.bootstrapcdn.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com data:; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://sakthiauto.com https://www.sakthiauto.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://www.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'" />
        <!--
          HSTS – uncomment only after SSL is confirmed working
          <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains" />
        -->
      </customHeaders>
    </httpProtocol>

    <!-- Block access to sensitive files -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="App_Data" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".sql" allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".sh"  allowed="false" />
          <add fileExtension=".inc" allowed="false" />
          <add fileExtension=".orig" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Static content caching -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Rewrite HTTP → HTTPS (enable after SSL certificate configured) -->
    <!--
    <rewrite>
      <rules>
        <rule name="Force HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
      </rules>
    </rewrite>
    -->
  </system.webServer>
</configuration>
